# Скопируйте в .env и подставьте свои значения.
# Секреты генерируются командами:
#   npm run secrets   → DEVICE_TOKEN и WEBHOOK_SECRET
#   npm run vapid     → VAPID_PUBLIC и VAPID_PRIVATE
# Файл .env в git не попадает (см. .gitignore).

# Публичный адрес сервиса — тот же, что в reverse proxy
PUBLIC_URL=https://tracker.example.com

# Длинный случайный токен: вводится в приложении один раз, в «Ещё → Сервер»
DEVICE_TOKEN=

# Случайный сегмент пути вебхука, адрес получится вида PUBLIC_URL/hook/<секрет>
WEBHOOK_SECRET=

# Ключи Web Push
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:you@example.com

# Адрес, с которого открывается приложение (через запятую, если их несколько)
ALLOWED_ORIGINS=https://your-login.github.io

PORT=8090
DATA_DIR=/data
